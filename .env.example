# Zoho OAuth — Client Credentials flow (Self Client created by a CRM org admin)
# Get from: https://api-console.zoho.in → Self Client
CLIENT_ID=your_client_id_here
CLIENT_SECRET=your_client_secret_here
ZOHO_SCOPE=ZohoCRM.functions.execute.READ,ZohoCRM.functions.execute.CREATE,ZohoCRM.modules.ALL
# ZohoCRM.<org id> — org id is in the CRM URL: crm.zoho.in/crm/org<NUMBER>/
ZOHO_SOID=ZohoCRM.your_org_id_here
API_DOMAIN=https://www.zohoapis.in
ACCOUNTS_URL=https://accounts.zoho.in

# Catalyst backend used by the frontend
VITE_BACKEND_URL=https://project-rainfall-60072062952.development.catalystserverless.in/server/otp_backend/
